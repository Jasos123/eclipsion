territory-auto-defense-lock-warning = WARNING: A territorial defence battery has locked onto this vessel!
territory-auto-defense-neutral-radio-warning = { $vessel }, this is an automated territorial defence battery. Maintain at least { $range } metres clearance. Crossing the perimeter will be met with fire.

territory-announcer-name = Sector Registry

territory-captured-announcement = { $faction } forces have raised their standard over { $region }. The installation now answers to them.
territory-neutralised-announcement = { $faction } has lost control of { $region }. The installation stands unclaimed.

territory-examine-owner = It flies [color=yellow]{ $faction }[/color] colours.
territory-examine-unclaimed = It flies no faction's colours. The ground here is unclaimed.
territory-examine-contested = [color=orangered]Rival factions are standing on the same ground - nobody is making progress.[/color]
territory-examine-progress = [color=cornflowerblue]{ $faction }[/color] is working the standard - [color=cornflowerblue]{ $percent }%[/color] done.
territory-examine-misconfigured = [color=red]Its registry plate is blank. This standard was mapped without a valid region ID and claims nothing.[/color]
