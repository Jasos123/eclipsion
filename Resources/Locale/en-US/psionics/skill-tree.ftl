action-name-psionic-skill-tree = Psionic Development
action-description-psionic-skill-tree = Open your psionic skill tree and spend development points.

psionic-skill-tree-window-title = Psionic Development
psionic-skill-tree-general-name = Latent Psychic Development
psionic-skill-tree-fire-name = Pyromancer Development
psionic-skill-tree-life-name = Biomancer Development
psionic-skill-tree-mind-name = Psychohistorian Development
psionic-skill-tree-level = Psionic level: {$level}
psionic-skill-tree-points = Available points: {$points}
psionic-skill-tree-progress = Potentia: {$current} / {$required}
psionic-skill-tree-level-up = Your psionic potential reaches level {$level}. You gain one development point.
psionic-skill-tree-owned = Unlocked
psionic-skill-tree-locked = Locked
psionic-skill-tree-exclusive = Locked by your choice of {$skill}.
psionic-skill-tree-requires = Requires {$skill}.
psionic-skill-tree-requires-level = Requires psionic level {$level}.
psionic-skill-tree-requires-points = Requires {$points} development point(s).
psionic-skill-tree-unlock-cost = Unlock — {$points} point(s), level {$level}

psionic-skill-branch-fire-name = Fire
psionic-skill-branch-fire-description = Shape heat, flame and entities born from the Secret of Fire.
psionic-skill-branch-stealth-name = Veil
psionic-skill-branch-stealth-description = See beyond barriers, vanish from psychic senses and move through shadow.
psionic-skill-branch-life-name = Life
psionic-skill-branch-life-description = Restore living bodies and eventually call the dead back to life.
psionic-skill-branch-mind-name = Mind
psionic-skill-branch-mind-description = Read the noosphere and impose your will upon other minds.
psionic-skill-branch-kinetic-name = Kinetic
psionic-skill-branch-kinetic-description = Manipulate matter, force and hostile supernatural effects.

psionic-skill-fireball-name = Fireball
psionic-skill-fireball-description = Release a close-range pyrokinetic flare around yourself.
psionic-skill-pyrokinesis-name = Pyrokinesis
psionic-skill-pyrokinesis-description = Ignite a flammable target at range.
psionic-skill-summon-imp-name = Summon Imp
psionic-skill-summon-imp-description = Call a fiery psionic familiar into the world.

psionic-skill-veil-sight-name = Veil Sight
psionic-skill-veil-sight-description = Project your awareness remotely to observe beyond walls and sealed rooms.
psionic-skill-invisibility-name = Brief Invisibility
psionic-skill-invisibility-description = Become invisible to psychically susceptible observers for a short time.
psionic-skill-shadeskip-name = Shadeskip
psionic-skill-shadeskip-description = Tear open the local veil with a burst of shadow.
psionic-skill-dark-swap-name = Dark Swap
psionic-skill-dark-swap-description = Shift between the material world and a shadowed state.

psionic-skill-healing-word-name = Healing Word
psionic-skill-healing-word-description = Restore another being with the Lesser Secret of Life.
psionic-skill-regeneration-name = Psionic Regeneration
psionic-skill-regeneration-description = Accelerate your own metabolism to mend your body.
psionic-skill-revivify-name = Revivify
psionic-skill-revivify-description = Speak the Greater Secret of Life and revive another being.

psionic-skill-telepathy-name = Telepathy
psionic-skill-telepathy-description = Establish the basic language of mind-to-mind communication.
psionic-skill-metapsionics-name = Metapsionic Pulse
psionic-skill-metapsionics-description = Sense nearby psychics and examine psionic signatures.
psionic-skill-zap-name = Noospheric Zap
psionic-skill-zap-description = Shock a target's consciousness through the noosphere.
psionic-skill-mass-sleep-name = Mass Sleep
psionic-skill-mass-sleep-description = Apex choice: force several nearby minds into sleep.
psionic-skill-mind-swap-name = Mind Swap
psionic-skill-mind-swap-description = Apex choice: exchange minds with a target. Choosing this locks Mass Sleep.

psionic-skill-anoigo-name = Anoigo
psionic-skill-anoigo-description = Manipulate a nearby target with focused kinetic force.
psionic-skill-telekinetic-pulse-name = Telekinetic Pulse
psionic-skill-telekinetic-pulse-description = Release a violent wave of telekinetic force around yourself.
psionic-skill-dispel-name = Dispel
psionic-skill-dispel-description = Unmake summoned entities and supernatural barriers.

command-grant-psionic-level-description = Grants one or more psionic levels and development points.
command-grant-psionic-level-help = Usage: grantpsioniclevel <entityUid> [amount]
command-grant-psionic-level-invalid-entity = The first argument must be a valid entity UID.
command-grant-psionic-level-invalid-amount = The amount must be a positive integer.
command-grant-psionic-level-not-psionic = That entity is not psionic.
