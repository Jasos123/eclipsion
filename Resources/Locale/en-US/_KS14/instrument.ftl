# KS14: chrome strings for the instrument-styled shuttle console shell.
# Visuals only - this fork took the look, not the sensor framework behind it.

ks-instrument-window-close = X
ks-instrument-tab-separator = //

ks-instrument-tab-nav = NAV
ks-instrument-tab-map = MAP
ks-instrument-tab-dock = DOCK
ks-instrument-tab-crew = CREW

# Always-on status strip under the tabs.
ks-status-shield-up = SHIELD { $percent }%
ks-status-shield-down = SHIELD DOWN { $time }s
ks-status-shield-none = SHIELD ---
ks-status-alert-taking-fire = ! TAKING FIRE !
